# Fichier d'exemple de variables d'environnement
# Copier ce fichier vers .env et remplir avec les valeurs réelles
# Ne JAMAIS commiter le fichier .env avec des valeurs réelles

# ====== Configuration Oracle DWH ======
DWH_DSN=hostname:1521/service_name
DWH_READONLY_USER=monitoring_user
DWH_READONLY_PASSWORD=secure_password_here
DWH_TABLE_NAME=DWH.CTI_EVENTS

# ====== Configuration générale ======
# Répertoire de logs (optionnel, par défaut : ./logs)
LOG_DIR=./logs

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
