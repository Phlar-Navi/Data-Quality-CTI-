# ==========================================
# .gitignore - Monitoring CTI
# ==========================================
Exclude/
Handover/
sample/

# Credentials (SENSIBLE)
.env
config/.env
.db_env

# Données générées
data/
*.db
*.db-shm
*.db-wal

# Logs
logs/
dashboard_data/
outliers/

# Documentation (à envoyer séparément)
# Documentation/

# Fichiers de test
test_utils/
logs_test/
dashboard_data_test/
*_test.py
*_test.yaml

# Markdown temporaires (sauf README et CHANGELOG)
#*.md
!README.md
!CHANGELOG.md
!GUIDE_BREAKPOINTS.md
!DOCUMENTATION_COMPLETE.md

# Fichiers système
*.PNG
*.rar
*.zip
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python
*.egg-info/
dist/
build/
